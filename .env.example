# ── Server ──────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///./data/app.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ENVIRONMENT=development
# Set true behind HTTPS in production
COOKIE_SECURE=false
SESSION_MAX_AGE_SECONDS=86400

# ── Uploads ─────────────────────────────────────────────
# Max upload size in megabytes
MAX_UPLOAD_MB=25
# Temporary storage (created automatically)
UPLOAD_DIR=./data/uploads
RESULT_DIR=./data/results

# ── Background removal model ────────────────────────────
# rembg model names (MIT / open models preferred):
#   birefnet-general   — best general-purpose quality (~973MB download)
#   birefnet-portrait  — portraits / hair focus
#   isnet-general-use  — strong edges, lighter than BiRefNet
#   u2net              — classic fallback (smaller, often already cached)
# Default uses u2net so first start is reliable offline; switch to
# birefnet-general for best quality once the ONNX file is downloaded.
REMBG_MODEL=u2net
# force cpu | cuda | mps | or leave empty for auto
INFERENCE_DEVICE=
# Enable rembg alpha-matting refinement for soft edges (hair/fur)
ALPHA_MATTING=true
# Skip full-res alpha matting when the longer side exceeds this (seconds saved on phone photos)
ALPHA_MATTING_MAX_SIDE=1280
ALPHA_MATTING_FOREGROUND_THRESHOLD=240
ALPHA_MATTING_BACKGROUND_THRESHOLD=10
ALPHA_MATTING_ERODE_SIZE=10
# Leave empty for auto (CoreML on Mac, CUDA if available, else CPU)
INFERENCE_DEVICE=

# ── Deploy (production) ─────────────────────────────────
# ENVIRONMENT=production
# COOKIE_SECURE=true
# COOKIE_SAMESITE=lax
# CORS_ORIGINS=https://your-app.vercel.app
# Bootstrap first admin on empty DB (Hugging Face Spaces):
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=change-me-strong
# ADMIN_NAME=Admin
# SKIP_MODEL_LOAD=0

